# Zkopíruj tento soubor jako .env (nebo .env.local) a vyplň hodnoty.
# .env je v .gitignore — NIKDY ho nepushuj do repa.
#
# Najdeš v Supabase: Project → Settings → API
#   - URL                = Project URL
#   - ANON KEY (public)  = anon / public key (bezpečné pro klienta)

VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJh...
